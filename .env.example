# Create a Neon Postgres database through Vercel's Storage/Marketplace screen,
# then copy its connection string here for local development and into Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Choose a strong private password for the /admin login page.
ADMIN_PASSWORD=replace-with-a-strong-password

# Generate a separate long random secret used to sign secure admin sessions.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Vercel uses this to call the daily reservation cleanup task.
CRON_SECRET=replace-with-a-long-random-secret
